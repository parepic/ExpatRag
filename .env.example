# Ends
FRONTEND_URL=http://localhost:3000

SUPABASE_API_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=sb_secret_.....

# OpenAI
OPENAI_API_KEY=sk-.....

# Optional LangSmith tracing for LangChain
LANGSMITH_API_KEY=lsv2_pt_.....
LANGSMITH_ENDPOINT=...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=patty

TAVILY_API_KEY = tvly-...

SCRAPE_DO_TOKEN=...

# Email sending (Resend)
# Get your API key at https://resend.com
# For local dev, use onboarding@resend.dev as EMAIL_SENDER (no domain verification needed).
# For production, set EMAIL_SENDER to an address on a verified domain in your Resend account.
RESEND_API_KEY=re_...
EMAIL_SENDER=onboarding@resend.dev